# Funland 运行环境配置 (部署时可填入你的自定义域名，未绑定时自动以访问 IP 或主机名为准)
BASE_DOMAIN=

# 端口配置
PORT_PORTAL=8098
PORT_ADMIN=8091
PORT_EMBY=8097

# 目标 Emby 服务器
EMBY_UPSTREAM_URL=https://your-emby-server:8096
EMBY_API_KEY=

# 管理控制台密钥
ADMIN_USER=admin
ADMIN_PASSWORD=funland2026
JWT_SECRET=change-this-jwt-token-secret-for-production

# 缓存配置 (30分钟滑动过期 = 1800秒)
CACHE_TTL_SECONDS=1800
# REDIS_URL=redis://127.0.0.1:6379 (可选，默认使用内置高速内存缓存)

# 数据存储目录
DATA_DIR=./data
